{
  "name": "agentic-pr-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node --check src/quote.js && node --check src/server.js && node --check scripts/build.mjs && node --check scripts/smoke.mjs",
    "test": "node --test test/*.test.js",
    "coverage": "node --test --experimental-test-coverage test/*.test.js",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev": "node src/server.js",
    "start": "node dist/server.js"
  }
}
